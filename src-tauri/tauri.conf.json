{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonar",
  "version": "0.12.0",
  "identifier": "com.hafij.sonar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "deb"
    ],
    "resources": [
      "resources/**/*"
    ],
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-layer-shell0",
          "libopenblas0",
          "libssl3t64 | libssl3",
          "wl-clipboard"
        ],
        "files": {
          "/usr/lib/Sonar": "transcribe-libs",
          "/usr/share/applications/com.hafij.sonar.desktop": "linux/com.hafij.sonar.desktop"
        }
      },
      "rpm": {
        "depends": [
          "libgtk-layer-shell.so.0()(64bit)",
          "libopenblas.so.0()(64bit)"
        ],
        "compression": {
          "type": "none"
        },
        "files": {
          "/usr/lib/Sonar": "transcribe-libs"
        }
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib": "transcribe-libs"
        }
      }
    },
    "shortDescription": "Bangla and English voice typing",
    "longDescription": "Hold a shortcut, speak Bangla or English, let go: Sonar types your words into any app. Runs offline with a Bangla Whisper model, or in the cloud with your own Gemini key. Built on Handy (MIT).",
    "category": "Utility",
    "publisher": "Hafij-BGE"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBQjcyMDk1MjA2NjAxRjkKUldUNUFXWWdsU0MzdXRRZi8zYzhqV2FaNUVDbDd2Rk5VM1IvWWowVXdmRFNKQ1BrMXF5RFFsLy8K",
      "endpoints": []
    }
  },
  "mainBinaryName": "sonar"
}
